# Sinh câu trả lời bằng Ollama local — không cần API key. Chạy `ollama serve` trên máy
# (không cần bật OLLAMA_ORIGINS/CORS vì server Express gọi Ollama, không phải trình duyệt).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# Tuỳ chọn: chỉ cần điền nếu muốn dùng Dense/Hybrid retrieval hoặc Jina Reranker
# (mặc định app dùng BM25 + không rerank, không cần các key này).
JINA_API_KEY=""
JINA_EMBED_MODEL="jina-embeddings-v3"
JINA_RERANK_MODEL="jina-reranker-v2-base-multilingual"
JINA_API_BASE_URL="https://api.jina.ai/v1"
JINA_EMBED_DIMENSIONS="1024"

# The bundled dataset.jsonl is used by default in web deployments.
# VIHERMES_DATASET_PATH="/absolute/path/to/dataset.jsonl"
PORT="3000"
EMBED_BATCH_SIZE="32"
